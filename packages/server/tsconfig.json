{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The server runs only in Node. (The contract, the mapping and the handler use no
    // Node API, and import none: keep it that way, so they run anywhere.)
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}

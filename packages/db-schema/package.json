{
  "name": "@woodpatch/gcode-db",
  "version": "0.0.0",
  "private": true,
  "description": "The machine record's format: a strict parser, its canonical hash, validation and a JSON Schema. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/machine-record-v1.schema.json": "./schema/machine-record-v1.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WoodpatchAU/woodpatch-gcode-toolkit.git",
    "directory": "packages/db-schema"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@woodpatch/gcode-core": "workspace:*",
    "@types/node": "^22.20.3",
    "fast-check": "^4.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

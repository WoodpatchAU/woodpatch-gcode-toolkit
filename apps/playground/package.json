{
  "name": "@woodpatch/gcode-playground",
  "version": "0.0.0",
  "private": true,
  "description": "The public G-code playground: drop or paste a file, see the 3D path, the code and the diagnostics in sync.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-samples.mjs && vite build && node scripts/check-notice.mjs && node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@woodpatch/gcode-core": "workspace:*",
    "@woodpatch/gcode-editor": "workspace:*",
    "@woodpatch/gcode-viewer": "workspace:*",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "lighthouse": "13.5.0",
    "typescript": "~6.0.3",
    "vite": "8.3.0"
  }
}

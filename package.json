{
  "name": "woodpatch-gcode-toolkit",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "licence:reuse": "reuse lint",
    "licence:packages": "node scripts/check-package-licences.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  }
}
